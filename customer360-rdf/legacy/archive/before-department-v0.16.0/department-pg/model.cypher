SET n += {business_scope_kind: "product", definition: "銀行存款利收；依私銀 SQL 業務字典記錄來源範圍，計算由 Tool 承接。", definition_department: "私人銀行", department_owner_json: "null", metric_kind: "interest_income", name: "銀行存款利收", observations_json: "{\"amount_observation\":\"SQL 加總 GROSS_INCM；這是銀行業務利收，不宣稱等於客戶收到的存款利息。\",\"classification_observation\":\"9.INCOME_SMY.sql 歸類為利收／銀行／存款；沿用 BankInterestIncome 與 DepositProduct。\",\"coverage\":\"INCOME_066 存款利收：台幣／外幣／行員存款歷史月檔及外幣 current；依 SQL 整體存款範圍記錄，不拆成三種存款利收。\",\"date_observation\":\"歷史 YYYYMM||01 為月份標記，current 取 DATA_DT；月更新以 SYSDATE 上月替換，未核定期間起迄。\",\"evidence\":[\"deposit_income_current\",\"deposit_income_history\",\"deposit_income_monthly\",\"deposit_income_monthly_job\",\"deposit_income_summary\",\"private_products\"],\"gaps\":[\"只對應指標到底表；客戶、商品識別、幣別、收入期間及欄位映射維持待定。\",\"SQL 計算由 Tool 承接；來源觀察不是可執行規則，未查驗資料庫。\",\"歷史初建有私銀分行及 YYYYMM>202505 條件；上月替換分支未加同樣分行條件，保留範圍差異。\",\"初建歷史合併用 UNION ALL，上月替換用 UNION；不能直接相加所有分支。\",\"INCOME_066 引用 TMP01，但該檔前段定義位於註解；current 台幣表無 GROSS_INCM 的註記保留，不補作金額來源。\",\"存款利收先不新增理專歸屬；行員存款底表的存在不代表已完成存款人身分映射。\"]}", product_code: "deposit", scope: "metadata_only", specific_product_class_uri_json: "null", subsidiary: "bank", table_sources_json: "{\"coverage\":\"INCOME_066 存款利收：台幣／外幣／行員存款歷史月檔及外幣 current；依 SQL 整體存款範圍記錄，不拆成三種存款利收。\",\"status\":\"observed_in_files\",\"tables\":[{\"evidence\":[\"deposit_income_current\"],\"role\":\"primary\",\"table\":\"DSDEP.DEP_FN_ACCT\"},{\"evidence\":[\"deposit_income_history\",\"deposit_income_monthly\",\"deposit_income_monthly_job\"],\"role\":\"primary\",\"table\":\"DSDEP.DEP_FN_ACCT_HS\"},{\"evidence\":[\"deposit_income_history\",\"deposit_income_monthly\",\"deposit_income_monthly_job\"],\"role\":\"primary\",\"table\":\"DSDEP.DEP_NT_ACCT_HS\"},{\"evidence\":[\"deposit_income_history\",\"deposit_income_monthly\",\"deposit_income_monthly_job\"],\"role\":\"primary\",\"table\":\"DSDEP.EMP_DEP_NT_ACCT_HS\"}],\"unresolved_supporting_relations\":[]}", using_department: "私人銀行"};

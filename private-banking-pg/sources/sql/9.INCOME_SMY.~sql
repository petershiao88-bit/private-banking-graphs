drop table INCOME_TMP01;
Create table INCOME_TMP01
as 
select      
      '手收'  as  TYP,
      '銀行'  as  PROD_TYPE,
      '保險' AS   SUB_TYPE,
      dept_easy_nm as NM,
      cust_id,
      yyyymmdd ,
      AMT 
from INCOME_028  --各區當日手收數字(保險)
union
select 
      '手收'  as  TYP,
      '銀行'  as  PROD_TYPE,
      '保險' AS   SUB_TYPE, 
      '' as  NM,
      cust_id,
      yyyymmdd ,
      AMT 
from INCOME_029 --各區每月手收數字(保險
union 
select  
      '手收'  as  TYP,
      '銀行'  as  PROD_TYPE,
      '保險' AS   SUB_TYPE, 
      '' as  NM,
      cust_id,
      yyyymmdd ,
      AMT          
from INCOME_030  --各區每月手收數字(保險
union 
select  
      '手收'  as  TYP,
      '銀行'  as  PROD_TYPE,
      '海外債券_信託' AS   SUB_TYPE, 
      PCCODE as  NM,
      cust_id,
      yyyymmdd ,
      AMT          
from INCOME_031  --【銀行】海外債券手收 總量
union 
select  
      '手收'  as  TYP,
      '銀行'  as  PROD_TYPE,
      '外國債券_自營' AS   SUB_TYPE, 
      pccode as  NM,
      cust_id,
      yyyymmdd ,
      AMT          
from INCOME_032  --【銀行】外國債券(自營平台)手收 總量
union 
select 
      '手收'  as  TYP,
      '銀行'  as  PROD_TYPE,
      FH_TYP as SUB_TYPE,
      PCCODE as NM,
      cust_id,
      yyyymmdd,
      AMT
from INCOME_033_034_035_036
where FH_TYP is not null

SET n += {definition: "銀行境內 SI 結構型商品業務的手續費收入。", department_owner_json: "null", name: "境內結構型商品手收（SI）", observations_json: "{\"coverage\":\"僅納入 INCOME_039 的 SI 分支；尚未納入 INCOME_040 ELI 與 INCOME_041 FCI，不宣稱完整境內手收。\",\"event_date\":{\"column\":\"TRADE_DATE\",\"evidence\":[\"sql_si\",\"metadata_si\"],\"meaning\":\"交易日\"},\"evidence\":[\"metadata_si\",\"private_product_domestic\",\"sql_si\",\"sql_si_summary\"],\"fee_currency\":{\"current_column\":\"FEE_AMOUNT_TWD\",\"current_unit\":\"TWD\",\"evidence\":[\"metadata_si\"],\"historical_unit\":null,\"note\":\"current metadata 說明為手續費換算台幣；歷史表欄位語意未獨立核對，selected currency 保持 null。\"},\"gaps\":[\"S_PCC_CODE 在 SQL 中使用，但提供的 current metadata 未列此欄位。\",\"DEALNO 是交易單號，不當作商品 ID。\",\"current metadata 的專員欄位不自動套用到 HS；來源也未證明哪些行員具有理專角色。\",\"既有 SQL 已彙總並移除員編與商品識別，不直接用該彙總還原理專／單一商品手收。\"],\"sql_aggregation\":\"SUM(FEE_AMOUNT_TWD)\",\"sql_combination\":\"current／HS 各自聚合後 UNION（非 UNION ALL）\",\"sql_filters\":[],\"sql_group_by\":[\"CUSTOMER_ID\",\"TRADE_DATE\",\"S_PCC_CODE\"],\"sql_output\":\"INCOME_039\"}", private_product_code: "bank_structured_domestic", scope: "metadata_only", specific_product_class_uri_json: "\"https://example.org/ontology/bank#StructuredFinancialProduct\"", subsidiary: "bank", table_sources_json: "{\"coverage\":\"此 AUM／手收指標在既有 SQL 與 metadata 中的表級來源觀察；欄位映射、選日及執行規則未指定。\",\"status\":\"observed_in_files\",\"tables\":[{\"evidence\":[\"metadata_si\",\"sql_si\"],\"role\":\"primary\",\"table\":\"DSDEP.SI_PERFO_RPT\"},{\"evidence\":[\"sql_si\"],\"role\":\"primary\",\"table\":\"DSDEP.SI_PERFO_RPT_HS\"}],\"unresolved_supporting_relations\":[]}"};

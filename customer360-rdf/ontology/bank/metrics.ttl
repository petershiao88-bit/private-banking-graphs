# 銀行｜指標 v0.17.0，2026-10-31，設計草案。
# 子公司層－銀行／指標：銀行 AUM、LUM、手收、利收，以及手收歸屬理專的關係。
# 由 v0.16.0 的 bank-common.ttl 拆出（FIBO 式模組化），類別與屬性定義未改。example.org 為示意命名空間。

@prefix bank: <https://example.org/ontology/bank#> .
@prefix fh: <https://example.org/ontology/holding#> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bank:BankAUM a owl:Class ;
    rdfs:label "銀行 AUM"@zh-TW ;
    rdfs:subClassOf fh:AUM ;
    skos:definition "衡量指定快照日依銀行管理與認列口徑計算之客戶資產規模的指標。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "銀行" .

bank:BankInterestIncome a owl:Class ;
    rdfs:label "銀行利收"@zh-TW ;
    rdfs:subClassOf fh:InterestIncome ;
    skos:definition "銀行業務中依認列口徑衡量的利收指標；具體涵蓋範圍由部門描述。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "銀行" .

bank:BankLUM a owl:Class ;
    rdfs:label "銀行 LUM"@zh-TW ;
    rdfs:subClassOf fh:LUM ;
    skos:definition "銀行業務中依認列口徑衡量的 LUM 指標；具體涵蓋範圍由部門描述。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "銀行" .

bank:attributedToAdvisor a owl:ObjectProperty ;
    rdfs:label "歸屬理專"@zh-TW ;
    rdfs:domain bank:BankFeeIncome ;
    rdfs:range bank:FinancialAdvisor ;
    skos:definition "銀行手收歸屬於理專的關係。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "銀行" .

<https://example.org/ontology/bank/metrics> a owl:Ontology ;
    rdfs:label "銀行｜指標"@zh-TW ;
    rdfs:comment "銀行 AUM、LUM、手收、利收，以及手收歸屬理專的關係。"@zh-TW ;
    owl:imports <https://example.org/ontology/bank/parties>,
        <https://example.org/ontology/holding/annotations>,
        <https://example.org/ontology/holding/metrics> ;
    owl:versionIRI <https://example.org/ontology/bank/metrics/0.17.0> ;
    owl:versionInfo "0.17.0 / design draft / 2026-10-31" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

bank:BankFeeIncome a owl:Class ;
    rdfs:label "銀行手收指標"@zh-TW ;
    rdfs:subClassOf fh:FeeIncome ;
    skos:definition "衡量銀行於指定收入期間內依銀行認列規則形成之手收的指標。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "銀行" .


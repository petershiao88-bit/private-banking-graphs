SET n += {business_scope_kind: "product", definition: "銀行放款利收（來源業務收益口徑）；沿用私銀 SQL 的業務分類，僅對應指標到底表，實際認列與欄位映射待確認。", definition_department: "私人銀行", department_owner_json: "null", metric_kind: "interest_income", name: "銀行放款利收（來源業務收益口徑）", observations_json: "{\"amount_observation\":\"SQL 歸利收／銀行／放款。台幣歷史加總 GROSS_INCM（metadata 為毛利）；外幣歷史及 current 加總 INT_INCM 減 CB_INT_AMT（利息收入減聯行息收入）。業務利收不限定為純客戶利息。\",\"classification_observation\":\"使用者確認本專案先統一納為銀行金融商品，直接參照金控金融商品分類；收入沿用來源 SQL 手收／利收分類。\",\"coverage\":\"私銀 SQL INCOME_067 的台幣／外幣歷史月更新及外幣 current 收入分支；並非已查驗完整生產時間覆蓋。\",\"date_observation\":\"歷史 YYYYMM 加 01 為月份標記；current 觀察 data_dt，日期與收入期間未核定。\",\"evidence\":[\"income_scope_summary\",\"loan_fn_metadata\",\"loan_income\",\"loan_income_current\",\"loan_income_summary\",\"loan_nt_metadata\",\"private_products\"],\"gaps\":[\"原 SQL 業務收益口徑與純利息收入不同，認列／組成待定。\",\"台外幣換算、期間與 UNION ALL 僅為來源觀察。\",\"客戶、商品識別、幣別、收入歸屬與所有欄位映射待定。\",\"放款規模另由 bank.loan_lum 承接；本輪不新增放款 AUM、授信額度或契約。\",\"current 分支分行條件與歷史月更新不同；不把所有分支視為完整一致覆蓋。\",\"本輪利收未新增理專歸屬關係。\"]}", product_code: "loan", scope: "metadata_only", specific_product_class_uri_json: "null", subsidiary: "bank", table_sources_json: "{\"coverage\":\"僅對應該指標已觀察的金額來源分支，不表示全表只屬於該商品或服務。\",\"status\":\"observed_in_files\",\"tables\":[{\"evidence\":[\"loan_income_current\"],\"role\":\"primary\",\"table\":\"DSLON.LN_FN_ACCT\"},{\"evidence\":[\"loan_income\"],\"role\":\"primary\",\"table\":\"DSLON.LN_FN_ACCT_HS\"},{\"evidence\":[\"loan_income\"],\"role\":\"primary\",\"table\":\"DSLON.LN_NT_ACCT_HS\"}],\"unresolved_supporting_relations\":[]}", using_department: "私人銀行"};

    {
      "parameters": {
        "jsCode": "const rows = $input\n  .all()\n  .map(item => item.json)\n  .filter(row => Object.keys(row).length > 0);\n\nconst router = $('metric router').first().json.output ?? {};\n\nconst hasUnsupportedError = rows.some(\n  row => row.error_message === 'UNSUPPORTED_METRIC_OR_MISSING_SOURCE_TABLE'\n);\n\nreturn [\n  {\n    json: {\n      status: hasUnsupportedError ? 'unsupported' : 'success',\n      user_query: $('Router Input').first().json.user_query,\n      metric_codes: router.selected_metric_codes ?? [],\n      output_grain:\n        router.output_grain ??\n        router.selected_output_grain ??\n        'dynamic',\n      row_count: rows.length,\n      columns: rows.length > 0 ? Object.keys(rows[0]) : [],\n      rows\n    }\n  }\n];"
      },

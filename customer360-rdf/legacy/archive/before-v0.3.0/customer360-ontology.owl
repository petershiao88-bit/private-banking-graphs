    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>人壽</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#AddressContactInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="zh-TW">證券地址通聯資訊</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#ContactInformation" />
    <skos:definition xml:lang="zh-TW">由證券整理及提供、與客戶相關的地址通聯資訊，承接該公司系統建立的權威通聯資料。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>

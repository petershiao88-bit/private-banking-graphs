      "observations": {
        "coverage": "僅觀察 INCOME_042 的 SN 分行手續費範圍。",
        "sql_output": "INCOME_042",
        "sql_group_by": [
          "FEEDATE",
          "IDNO",
          "BAOPCCCODE"
        ],
        "sql_aggregation": "SUM(BRHREBATEAMT)",
        "sql_combination": null,
        "sql_filters": [
          "FHID='SN'",
          "BAOPCCCODE LIKE '2E%'"
        ],
        "event_date": {
          "column": "FEEDATE",

{
  "name": "智能查詢 - 概念圖 KB 測試版",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ (() => {\nconst query = String($json.output || '').trim();\nconst sources = $('Available Source Metadata').item.json.available_sources;\nconst available = sources.map(s => (s.schema_name+'.'+s.table_name).toLowerCase());\nconst references = []; const pattern = /\\b(?:from|join)\\s+(\"?[a-zA-Z_][\\w$]*\"?)\\s*\\.\\s*(\"?[a-zA-Z_][\\w$]*\"?)/gi; let m; while ((m=pattern.exec(query)) !== null) references.push((m[1]+'.'+m[2]).replace(/\"/g,'').toLowerCase());\nif (references.some(t => !available.includes(t))) return \"SELECT 'UNSUPPORTED_METRIC_OR_MISSING_SOURCE_TABLE' AS error_message;\";\nconst ctes=[]; const ctePattern=/(?:\\bwith|,)\\s*([a-zA-Z_][\\w$]*)\\s+as\\s*\\(/gi; while ((m=ctePattern.exec(query))!==null) ctes.push(m[1].toLowerCase());\nconst fromPattern=/\\b(?:from|join)\\s+(\"?[a-zA-Z_][\\w$]*\"?)(?:\\s*\\.\\s*(\"?[a-zA-Z_][\\w$]*\"?))?/gi;\nwhile ((m=fromPattern.exec(query))!==null) { if (!m[2] && !ctes.includes(m[1].replace(/\"/g,'').toLowerCase())) return \"SELECT 'UNSUPPORTED_METRIC_OR_MISSING_SOURCE_TABLE' AS error_message;\"; }\nreturn query;\n})() }}",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [

# 金控｜當事人 v0.17.0，2026-10-31，設計草案。
# 金控層／當事人：客戶、職員、通聯資訊，以及職員服務客戶、客戶具有通聯資訊的關係。
# 由 v0.16.0 的 holding-core.ttl 拆出（FIBO 式模組化），類別與屬性定義未改。example.org 為示意命名空間。

@prefix fh: <https://example.org/ontology/holding#> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fh:addressLine a owl:DatatypeProperty ;
    rdfs:label "街道門牌地址"@zh-TW ;
    rdfs:domain fh:AddressContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "地址的路街段、巷弄、門牌、樓層與室等詳細內容。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:city a owl:DatatypeProperty ;
    rdfs:label "縣市"@zh-TW ;
    rdfs:domain fh:AddressContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "地址的縣市。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:countryCode a owl:DatatypeProperty ;
    rdfs:label "國家／地區代碼"@zh-TW ;
    rdfs:domain fh:AddressContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "地址所屬國家或地區的代碼。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:district a owl:DatatypeProperty ;
    rdfs:label "鄉鎮市區"@zh-TW ;
    rdfs:domain fh:AddressContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "地址的鄉鎮市區。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:fullAddress a owl:DatatypeProperty ;
    rdfs:label "完整地址"@zh-TW ;
    rdfs:domain fh:AddressContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "完整地址文字。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:hasContactPoint a owl:ObjectProperty ;
    rdfs:label "具有通聯資訊"@zh-TW ;
    rdfs:domain fh:Customer ;
    rdfs:range fh:ContactInformation ;
    skos:definition "客戶具有通聯資訊。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:mobileNumber a owl:DatatypeProperty ;
    rdfs:label "手機號碼"@zh-TW ;
    rdfs:domain fh:MobileContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "手機通聯資訊的號碼字串。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:postalCode a owl:DatatypeProperty ;
    rdfs:label "郵遞區號"@zh-TW ;
    rdfs:domain fh:AddressContactInformation ;
    rdfs:range xsd:string ;
    skos:definition "地址的郵遞區號字串。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:serves a owl:ObjectProperty ;
    rdfs:label "服務客戶"@zh-TW ;
    rdfs:domain fh:Employee ;
    rdfs:range fh:Customer ;
    skos:definition "職員向客戶提供業務服務的關係。"@zh-TW ;
    fh:governanceLevel "金控" .

<https://example.org/ontology/holding/parties> a owl:Ontology ;
    rdfs:label "金控｜當事人"@zh-TW ;
    rdfs:comment "客戶、職員、通聯資訊，以及職員服務客戶、客戶具有通聯資訊的關係。"@zh-TW ;
    owl:imports <https://example.org/ontology/holding/annotations> ;
    owl:versionIRI <https://example.org/ontology/holding/parties/0.17.0> ;
    owl:versionInfo "0.17.0 / design draft / 2026-10-31" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fh:Employee a owl:Class ;
    rdfs:label "職員"@zh-TW ;
    skos:definition "任職於金控或旗下子公司的人員。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:MobileContactInformation a owl:Class ;
    rdfs:label "手機通聯資訊"@zh-TW ;
    rdfs:subClassOf fh:ContactInformation ;
    skos:definition "以手機號碼聯絡客戶的通聯資訊。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:Customer a owl:Class ;
    rdfs:label "客戶"@zh-TW ;
    skos:definition "集團業務中所服務的客戶。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:ContactInformation a owl:Class ;
    rdfs:label "通聯資訊"@zh-TW ;
    skos:definition "與客戶相關的聯絡資訊。"@zh-TW ;
    fh:governanceLevel "金控" .

fh:AddressContactInformation a owl:Class ;
    rdfs:label "地址通聯資訊"@zh-TW ;
    rdfs:subClassOf fh:ContactInformation ;
    skos:definition "以實體地址聯絡客戶的通聯資訊。"@zh-TW ;
    fh:governanceLevel "金控" .


<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:fh="https://example.org/ontology/holding#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://example.org/ontology/holding#valuationQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">估值數量</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AUM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="zh-TW">適用 AUM 估值情境中作為計算輸入的數量，例如股數、單位數或面額；具體數量單位由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#SecuritiesFeeIncome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">證券手收指標</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <skos:definition xml:lang="zh-TW">衡量證券公司於指定收入期間內依其認列規則形成之手收的指標。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#PrivateBankingDepartment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">私人銀行部門</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#Department"/>
    <skos:definition xml:lang="zh-TW">銀行從事私人銀行業務的部門類型；具體指標採用範圍在部門 PG 描述，暫不細分一部、二部、分行或團隊。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#postalCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">郵遞區號</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AddressContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">地址的郵遞區號字串。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#measuresProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">衡量金融商品</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AUM"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">AUM 衡量其所對應金融商品的資產規模。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#BankFeeIncome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行手收指標</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <skos:definition xml:lang="zh-TW">衡量銀行於指定收入期間內依銀行認列規則形成之手收的指標。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#ETFProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行 ETF 商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">客戶透過銀行通路交易或持有的 ETF 商品；私銀實際涵蓋範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#addressLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">街道門牌地址</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AddressContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">地址的路街段、巷弄、門牌、樓層與室等詳細內容。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#feeIncomeFromProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">手收來源商品</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">手收來自其所對應金融商品的關係。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#lumMeasuresProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">LUM 衡量金融商品</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#LUM"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">LUM 衡量其所對應金融商品之放款或融通餘額。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#FeeIncome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">手收指標</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#Metric"/>
    <skos:definition xml:lang="zh-TW">衡量指定收入期間內依業務認列口徑歸入手收的收入指標；具體涵蓋範圍由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#CollectiveManagementProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行集合管理投資商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">銀行依信託約定，將營運範圍或方法相同的信託資金集合管理運用的投資商品；私銀實際涵蓋範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#DepositProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">存款商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">銀行提供、供客戶依約定存放資金的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#valuationUnitPrice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">估值單價</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AUM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="zh-TW">適用 AUM 估值情境中作為計算輸入的價格或淨值；具體報價基準由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#city">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">縣市</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AddressContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">地址的縣市。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#district">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">鄉鎮市區</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AddressContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">地址的鄉鎮市區。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#ContactInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">通聯資訊</rdfs:label>
    <skos:definition xml:lang="zh-TW">與客戶相關的聯絡資訊。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#label">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh-TW">名稱</rdfs:label>
    <skos:definition xml:lang="zh-TW">類別或屬性的顯示名稱。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#GoldProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行黃金商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">銀行通路提供的黃金類商品；實際承作形式與涵蓋範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#BankEmployee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">行員</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#Employee"/>
    <skos:definition xml:lang="zh-TW">任職於銀行的職員。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#attributedToAdvisor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">歸屬理專</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/bank#BankFeeIncome"/>
    <rdfs:range rdf:resource="https://example.org/ontology/bank#FinancialAdvisor"/>
    <skos:definition xml:lang="zh-TW">銀行手收歸屬於理專的關係。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/customer360">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="zh-TW">客戶360共通語意整合本體</rdfs:label>
    <owl:versionIRI rdf:resource="https://example.org/ontology/customer360/0.16.0"/>
    <owl:versionInfo>0.16.0 / design draft / 2026-10-24</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#TWDFinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">台幣金融商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">以新臺幣計價的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#feeBaseAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">手收計算基礎金額</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="zh-TW">適用手收計算情境中作為輸入的收入金額；具體組成與來源由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#incomePeriodStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">收入期間起日</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:definition xml:lang="zh-TW">手收所屬收入期間的開始日期；不預設按日、月或年衡量。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#StockProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">股票商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">代表公司股權的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#interestPeriodEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">利收期間迄日</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#InterestIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:definition xml:lang="zh-TW">利收所屬收入期間的結束日期；具體期間與認列規則由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#Employee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">職員</rdfs:label>
    <skos:definition xml:lang="zh-TW">任職於金控或旗下子公司的人員。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#InsuranceProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行保險商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">銀行通路提供的保險商品；實際納入私人銀行業務的保險範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#ForeignCurrencyFinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">外幣金融商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">以新臺幣以外貨幣計價的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#metricAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">指標金額</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#Metric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="zh-TW">量化業務指標的結果金額，包含 AUM、LUM、手收與利收；具體計算與認列口徑由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#fullAddress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">完整地址</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AddressContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">完整地址文字。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#FinancialAdvisor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">理專</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/bank#BankEmployee"/>
    <skos:definition xml:lang="zh-TW">擔任理財諮詢與金融商品服務職務的銀行行員。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#hasContactPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">具有通聯資訊</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#Customer"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#ContactInformation"/>
    <skos:definition xml:lang="zh-TW">客戶具有通聯資訊。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#LoanProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行放款商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">銀行依授信安排提供客戶使用資金的融資商品；不以放款餘額直接認定為 AUM。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#BankAUM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行 AUM</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#AUM"/>
    <skos:definition xml:lang="zh-TW">衡量指定快照日依銀行管理與認列口徑計算之客戶資產規模的指標。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh-TW">定義</rdfs:label>
    <skos:definition xml:lang="zh-TW">類別或屬性的業務意義。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#serves">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">服務客戶</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#Employee"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#Customer"/>
    <skos:definition xml:lang="zh-TW">職員向客戶提供業務服務的關係。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#BankLUM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行 LUM</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#LUM"/>
    <skos:definition xml:lang="zh-TW">銀行業務中依認列口徑衡量的 LUM 指標；具體涵蓋範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#Metric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">指標</rdfs:label>
    <skos:definition xml:lang="zh-TW">依明確口徑衡量業務狀況的量化項目。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#holds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">持有金融商品</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#Customer"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">客戶持有金融商品。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#Customer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">客戶</rdfs:label>
    <skos:definition xml:lang="zh-TW">集團業務中所服務的客戶。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#FinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">金融商品</rdfs:label>
    <skos:definition xml:lang="zh-TW">金融機構提供的金融商品。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#LetterOfCreditProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行開狀商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">本專案依金融商品口徑分類之銀行開狀及相關貿易支付安排業務。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#BondProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">債券商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">發行人為籌資而發行、約定清償條件的債務型金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#OverseasFinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">海外金融商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">證券業務中歸入海外投資範圍的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#SecuritiesAUM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">證券 AUM</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#AUM"/>
    <skos:definition xml:lang="zh-TW">衡量指定快照日依證券公司管理與認列口徑計算之客戶資產規模的指標。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#FundProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">基金商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">透過集合投資方式，由專業管理機構依基金契約管理運用資產的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#incomePeriodEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">收入期間迄日</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:definition xml:lang="zh-TW">手收所屬收入期間的結束日期；期間邊界的具體使用規則由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#feeDeductionAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">手收計算扣減金額</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#FeeIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="zh-TW">適用手收計算情境中涉及的扣減金額；具體扣減項目與使用方式由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#Department">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">部門</rdfs:label>
    <skos:definition xml:lang="zh-TW">金控或旗下子公司的業務組織單位類型；具體部門與採用指標範圍由子公司及部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#LUM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">LUM</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#Metric"/>
    <skos:definition xml:lang="zh-TW">衡量指定基準日納入業務管理範圍之放款或融通餘額的指標；具體涵蓋與認列口徑由子公司或部門描述，不以擔保品估值或未動用額度代替。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#BankInterestIncome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行利收</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#InterestIncome"/>
    <skos:definition xml:lang="zh-TW">銀行業務中依認列口徑衡量的利收指標；具體涵蓋範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#employeeId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">行員編號</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/bank#BankEmployee"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">銀行用來識別行員的編號。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#ForeignExchangeProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行外匯商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">本專案依金融商品口徑分類之銀行貨幣兌換與外匯交易業務；來源分類不直接決定收入會計性質。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#FundProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">基金商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">透過集合投資方式，由專業管理機構依基金契約管理運用資產的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#governanceLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh-TW">治理層級</rdfs:label>
    <skos:definition xml:lang="zh-TW">模型定義的治理層級。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#countryCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">國家／地區代碼</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AddressContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">地址所屬國家或地區的代碼。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#lumAsOfDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">LUM 基準日</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#LUM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:definition xml:lang="zh-TW">LUM 所衡量放款或融通餘額對應的日期；具體選日與月份標記處理由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#interestPeriodStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">利收期間起日</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#InterestIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:definition xml:lang="zh-TW">利收所屬收入期間的開始日期；具體期間與認列規則由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#BondProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">債券商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">發行人為籌資而發行、約定清償條件的債務型金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#MobileContactInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">手機通聯資訊</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#ContactInformation"/>
    <skos:definition xml:lang="zh-TW">以手機號碼聯絡客戶的通聯資訊。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#aumAsOfDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">AUM 基準日</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#AUM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:definition xml:lang="zh-TW">AUM 所衡量資產規模對應的日期；具體選日規則由子公司或部門描述。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#PlannedTrustProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行規劃型信託商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">本專案依金融商品口徑分類之規劃型信託業務，依信託目的與契約安排管理或運用客戶財產；私銀實際涵蓋的一般信託與員工持股信託範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#StructuredFinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">結構型金融商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">報酬條件依約定公式連結金融指標或標的表現的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#OverseasFinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">海外金融商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">銀行業務中歸入海外投資範圍的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#usesMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">採用指標</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#Department"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#Metric"/>
    <skos:definition xml:lang="zh-TW">部門採用某項指標衡量業務狀況；不因此決定承作子公司、來源資料權責、理專歸屬或自動加總方式。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#InterestIncome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">利收指標</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#Metric"/>
    <skos:definition xml:lang="zh-TW">衡量指定收入期間內依業務認列口徑歸入利收的收入指標；具體收益組成與涵蓋範圍由子公司或部門描述，不限定為純客戶利息。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#AUM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">AUM</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#Metric"/>
    <skos:definition xml:lang="zh-TW">衡量指定快照日依管理與認列口徑計算之資產規模的指標。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/bank#TrustCustodyProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">銀行信託保管商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">本專案依金融商品口徑分類之信託保管業務，依約提供客戶資產保管；實際管理資產與收入範圍由部門描述。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>銀行</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#subsidiary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh-TW">所屬子公司</rdfs:label>
    <skos:definition xml:lang="zh-TW">模型定義的子公司治理歸屬。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#StructuredFinancialProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">結構型金融商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">依商品契約將金融工具組合，形成特定收益或風險條件的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#interestIncomeFromProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh-TW">利收來源商品</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#InterestIncome"/>
    <rdfs:range rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">依業務認列口徑歸入利收的收入來自其所對應金融商品的關係。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#AddressContactInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">地址通聯資訊</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#ContactInformation"/>
    <skos:definition xml:lang="zh-TW">以實體地址聯絡客戶的通聯資訊。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#mobileNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh-TW">手機號碼</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/holding#MobileContactInformation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="zh-TW">手機通聯資訊的號碼字串。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/securities#StockProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh-TW">股票商品</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/holding#FinancialProduct"/>
    <skos:definition xml:lang="zh-TW">代表公司股權的金融商品。</skos:definition>
    <fh:governanceLevel>子公司</fh:governanceLevel>
    <fh:subsidiary>證券</fh:subsidiary>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/holding#department">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh-TW">所屬部門</rdfs:label>
    <skos:definition xml:lang="zh-TW">模型定義的部門治理歸屬。</skos:definition>
    <fh:governanceLevel>金控</fh:governanceLevel>
  </rdf:Description>
</rdf:RDF>

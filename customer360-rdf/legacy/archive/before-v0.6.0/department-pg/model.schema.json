{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/customer360/department-pg/model.schema.json",
  "title": "Department property graph metadata model",
  "description": "Metadata only. URI references are not RDF assertions or instance mappings. This version deliberately permits pending physical mappings only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_version", "scope", "inference", "instance_mapping", "concepts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ontology_version": {"const": "0.5.0"},
    "scope": {"const": "metadata_only"},
    "inference": {"const": false},
    "instance_mapping": {"const": false},
    "concepts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "subsidiary", "department_owner", "class_uri", "mappings"],
      "properties": {
        "id": {"enum": ["bank.loan_verification_mobile", "bank.customer_visit_address"]},
        "name": {"type": "string", "minLength": 1},
        "subsidiary": {"const": "bank"},
        "department_owner": {"type": "null"},
        "class_uri": {
          "enum": ["https://example.org/ontology/holding#MobileContactInformation", "https://example.org/ontology/holding#AddressContactInformation"]
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/mapping"}
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property_uri", "domain_uri", "range_uri", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^bank\\.(loan_verification_mobile|customer_visit_address)\\.[A-Za-z]+$"},
        "property_uri": {
          "enum": [
            "https://example.org/ontology/holding#mobileNumber",
            "https://example.org/ontology/holding#countryCode",
            "https://example.org/ontology/holding#city",
            "https://example.org/ontology/holding#district",
            "https://example.org/ontology/holding#addressLine",
            "https://example.org/ontology/holding#postalCode",
            "https://example.org/ontology/holding#fullAddress"
          ]
        },
        "domain_uri": {
          "enum": ["https://example.org/ontology/holding#MobileContactInformation", "https://example.org/ontology/holding#AddressContactInformation"]
        },
        "range_uri": {"const": "http://www.w3.org/2001/XMLSchema#string"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "table", "field", "sql", "join_rules", "filter_rules"],
          "properties": {
            "status": {"const": "pending"},
            "table": {"type": "null"},
            "field": {"type": "null"},
            "sql": {"type": "null"},
            "join_rules": {"type": "null"},
            "filter_rules": {"type": "null"}
          }
        }
      }
    }
  }
}

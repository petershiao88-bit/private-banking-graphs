WITH [{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1606",`code`:"bank_structured_domestic",`before`:{`productCode`:"bank_structured_domestic",`name`:"境內結構型商品",`productCategory`:"結構型商品",`businessChannel`:"銀行通路",`customerNeed`:"依商品契約安排投資配置",`definition`:"銀行通路提供的境內結構型商品，收益條件依商品契約安排。",`serviceDescription`:"境內結構型商品的承作及契約相關服務。",`aumDefinition`:"",`incomeDefinition`:"銀行境內結構型商品業務帶來的相關手續費收入。",`subsidiary`:"銀行"},`patch`:{`marketRegion`:"台灣"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1174",`code`:"bank_structured_offshore",`before`:{`productCode`:"bank_structured_offshore",`name`:"銀行境外結構型商品",`productCategory`:"結構型商品",`businessChannel`:"銀行通路",`customerNeed`:"依契約安排投資配置",`definition`:"客戶透過銀行通路交易或持有的境外結構型商品。",`serviceDescription`:"境外結構型商品的交易及持有相關服務。",`aumDefinition`:"客戶透過銀行通路持有的境外結構型商品資產規模。",`incomeDefinition`:"銀行境外結構型商品業務帶來的分行手續費收入。",`subsidiary`:"銀行"},`patch`:{`marketRegion`:"海外"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1173",`code`:"bank_collective_account",`before`:{`productCode`:"bank_collective_account",`name`:"集合管理帳戶",`productCategory`:"集合管理帳戶",`businessChannel`:"銀行信託通路",`customerNeed`:"信託資金管理、投資配置",`definition`:"透過帳戶安排集合管理運用信託資金的投資產品。",`serviceDescription`:"集合管理帳戶的資金管理及投資相關服務。",`aumDefinition`:"客戶持有的集合管理帳戶資產規模。",`incomeDefinition`:"",`subsidiary`:"銀行"},`patch`:{`dealingMode`:"信託"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1175",`code`:"bank_planned_trust",`before`:{`productCode`:"bank_planned_trust",`name`:"規劃型信託",`productCategory`:"信託",`businessChannel`:"銀行信託通路",`customerNeed`:"財產管理、信託安排",`definition`:"依信託目的與契約安排管理或運用客戶財產的信託服務。",`serviceDescription`:"信託契約安排、財產管理及相關服務。",`aumDefinition`:"客戶交付規劃型信託安排的資產規模，涵蓋已納入的一般信託與員工持股信託。",`incomeDefinition`:"規劃型信託服務的借券、管理及成立費收入，涵蓋已納入的員工持股信託。",`subsidiary`:"銀行"},`patch`:{`dealingMode`:"信託"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1176",`code`:"bank_trust_custody",`before`:{`productCode`:"bank_trust_custody",`name`:"信託保管",`productCategory`:"信託保管",`businessChannel`:"銀行信託通路",`customerNeed`:"資產保管",`definition`:"客戶將資產交付信託保管安排的服務。",`serviceDescription`:"依保管安排提供資產保管相關服務。",`aumDefinition`:"客戶交付信託保管的資產規模。",`incomeDefinition`:"信託保管服務帶來的保管費收入。",`subsidiary`:"銀行"},`patch`:{`dealingMode`:"信託"}}] AS changes
MATCH (p:PBConcept:PBConceptProduct) WITH changes,collect(p) AS products
CALL apoc.util.validate(size(products)<>25 OR any(e IN changes WHERE size([p IN products WHERE elementId(p)=e.id AND p.productCode=e.code AND (properties(p)=e.before OR properties(p)=apoc.map.merge(e.before,e.patch))])<>1), 'Classification baseline changed; no update applied', [])
WITH changes,products UNWIND changes AS e UNWIND [p IN products WHERE elementId(p)=e.id] AS p
WITH p,e,size([k IN keys(e.patch) WHERE p[k] IS NULL OR p[k]<>e.patch[k]]) AS delta
FOREACH (_ IN CASE WHEN delta>0 THEN [1] ELSE [] END | SET p += e.patch)
RETURN '已補齊確認的分類' AS 狀態,count(*) AS 目標節點,sum(CASE WHEN delta>0 THEN 1 ELSE 0 END) AS 更新節點,sum(delta) AS 新增分類值

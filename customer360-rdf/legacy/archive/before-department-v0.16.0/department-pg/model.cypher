MERGE (n:MetadataNode:BusinessConcept {id: "securities.bond_aum"})
SET n += {definition: "證券複委託債券 AUM；依私銀既有產品範圍記錄的指標候選，認列與來源映射尚待確認。", department_owner_json: "null", metric_kind: "aum", name: "證券複委託債券 AUM", observations_json: "{\"classification_observation\":\"SQL BOND LIKE 'TSSN%' 分成結構型，ELSE 為債券（含 SQL ELSE 的空值範圍，不能直接等同 NOT LIKE）。\",\"coverage\":\"證券複委託債券 AUM\",\"date_observation\":\"歷史匯率取全體每月 MAX(PRCS_DT)，current 按 CLRDATE 與幣別連匯率；歷史/current UNION，快照、匯率連接與去重均未核定。\",\"evidence\":[\"private_products\",\"sec_bond_aum\"],\"gaps\":[\"折台為 SQL 意圖，幣別及匯率口徑待確認。\",\"未核定 BOND 單一商品識別、理專與客戶跨系統識別。\"],\"valuation_observation\":\"SQL SUM(NETQTY / 100 * CPRICE * EXCH_RT)；所有金額候選為同一估值的組成輸入。\"}", product_class_uris_json: "[\"https://example.org/ontology/securities#BondProduct\",\"https://example.org/ontology/securities#OverseasFinancialProduct\"]", product_code: "securities_bond", scope: "metadata_only", specific_product_class_uri_json: "null", subsidiary: "securities", table_sources_json: "{\"coverage\":\"此 AUM／手收指標在既有 SQL 與 metadata 中的表級來源觀察；欄位映射、選日及執行規則未指定。\",\"status\":\"observed_in_files\",\"tables\":[{\"evidence\":[\"sec_bond_aum\"],\"role\":\"primary\",\"table\":\"DSPBM.PB_BONDPOS_SEC\"},{\"evidence\":[\"sec_bond_aum\"],\"role\":\"primary\",\"table\":\"DSPBM.PB_BONDPOS_SEC_M\"},{\"evidence\":[\"sec_bond_aum\",\"sec_stock_aum\"],\"role\":\"valuation_support\",\"table\":\"DSDEP.FN_EXCH_RT\"}],\"unresolved_supporting_relations\":[]}"};

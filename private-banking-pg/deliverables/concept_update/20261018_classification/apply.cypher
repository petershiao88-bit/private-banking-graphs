,`serviceDescription`:"台幣存款及資金存放相關服務。",`aumDefinition`:"客戶持有、納入台幣存款分類的銀行存款資產規模。",`incomeDefinition`:""},`patch`:{`subsidiary`:"銀行",`currencyType`:"台幣"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1610",`productCode`:"loan",`before`:{`productCode`:"loan",`name`:"放款",`offeringType`:"產品",`productCategory`:"放款",`businessChannel`:"銀行通路",`customerNeed`:"融資、資金調度",`definition`:"銀行依授信安排提供客戶使用資金的融資產品。",`serviceDescription`:"授信及放款相關服務。",`aumDefinition`:"",`incomeDefinition`:"放款業務歸入利收的收入，按已納入的業務收益口徑衡量。"},`patch`:{`subsidiary`:"銀行"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1177",`productCode`:"securities_bond",`before`:{`productCode`:"securities_bond",`name`:"證券複委託債券",`offeringType`:"產品",`productCategory`:"債券",`businessChannel`:"證券複委託通路",`customerNeed`:"海外債券投資配置",`definition`:"客戶透過證券複委託通路交易或持有的債券產品。",`serviceDescription`:"複委託債券交易及持有相關服務。",`aumDefinition`:"客戶透過證券複委託持有的債券資產規模。",`incomeDefinition`:"證券複委託債券交易帶來的客戶手續費收入。"},`patch`:{`subsidiary`:"證券",`marketRegion`:"海外",`dealingMode`:"複委託"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1180",`productCode`:"securities_foreign_stock",`before`:{`productCode`:"securities_foreign_stock",`name`:"證券複委託外國股票",`offeringType`:"產品",`productCategory`:"股票",`businessChannel`:"證券複委託通路",`customerNeed`:"海外股票投資配置",`definition`:"客戶透過證券複委託通路交易或持有的外國股票產品。",`serviceDescription`:"複委託外國股票交易及持有相關服務。",`aumDefinition`:"客戶透過證券複委託持有的外國股票資產規模。",`incomeDefinition`:"證券複委託外國股票交易扣除上手手續費後的淨手續費收入。"},`patch`:{`subsidiary`:"證券",`marketRegion`:"海外",`dealingMode`:"複委託"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1179",`productCode`:"securities_fund",`before`:{`productCode`:"securities_fund",`name`:"證券複委託基金",`offeringType`:"產品",`productCategory`:"基金",`businessChannel`:"證券複委託通路",`customerNeed`:"投資配置",`definition`:"客戶透過證券複委託通路申購或持有的基金產品。",`serviceDescription`:"複委託基金申購及持有相關服務。",`aumDefinition`:"客戶透過證券複委託持有的基金資產規模。",`incomeDefinition`:"證券複委託基金交易帶來、已納入業務範圍的手續費收入。"},`patch`:{`subsidiary`:"證券",`fundType`:"基金"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1178",`productCode`:"securities_structured",`before`:{`productCode`:"securities_structured",`name`:"證券複委託結構型商品",`offeringType`:"產品",`productCategory`:"結構型商品",`businessChannel`:"證券複委託通路",`customerNeed`:"依契約安排投資配置",`definition`:"客戶透過證券複委託通路交易或持有的結構型商品。",`serviceDescription`:"複委託結構型商品交易及持有相關服務。",`aumDefinition`:"客戶透過證券複委託持有的結構型商品資產規模。",`incomeDefinition`:"證券複委託結構型商品交易帶來的客戶手續費收入。"},`patch`:{`subsidiary`:"證券",`dealingMode`:"複委託"}},{`id`:"4:ed2a70ad-f2bd-474d-a187-fa6be5ba621f:1614",`productCode`:"securities_taiwan_stock",`before`:{`productCode`:"securities_taiwan_stock",`name`:"證券台股",`offeringType`:"產品",`productCategory`:"股票",`businessChannel`:"證券通路",`customerNeed`:"台灣股票投資配置",`definition`:"客戶透過證券通路交易或持有的台灣股票產品。",`serviceDescription`:"台股交易及持有相關服務。",`aumDefinition`:"客戶持有、納入證券台股分類的台灣股票資產規模。",`incomeDefinition`:""},`patch`:{`subsidiary`:"證券",`marketRegion`:"台灣"}}] AS changes
MATCH (n:PBConcept:PBConceptProduct) WITH changes,collect(n) AS products
CALL apoc.util.validate(size(products)<>25 OR any(e IN changes WHERE size([n IN products WHERE n.productCode=e.productCode AND elementId(n)=e.id AND (properties(n)=e.before OR properties(n)=apoc.map.merge(e.before,e.patch))])<>1), 'Classification baseline differs; no update applied', [])
WITH changes,products UNWIND changes AS e UNWIND [n IN products WHERE n.productCode=e.productCode AND elementId(n)=e.id] AS n
WITH n,e,size([k IN keys(e.patch) WHERE n[k] IS NULL OR n[k]<>e.patch[k]]) AS delta
FOREACH (_ IN CASE WHEN delta>0 THEN [1] ELSE [] END | SET n += e.patch)
RETURN '商品分類已更新' AS status,count(*) AS targetNodes,sum(CASE WHEN delta>0 THEN 1 ELSE 0 END) AS changedNodes,sum(delta) AS changedProperties

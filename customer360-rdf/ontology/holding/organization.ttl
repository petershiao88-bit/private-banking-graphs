# 金控｜組織 v0.17.0，2026-10-31，設計草案。
# 金控層／組織：部門，以及部門採用指標的關係。
# 由 v0.16.0 的 holding-core.ttl 拆出（FIBO 式模組化），類別與屬性定義未改。example.org 為示意命名空間。

@prefix fh: <https://example.org/ontology/holding#> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

fh:usesMetric a owl:ObjectProperty ;
    rdfs:label "採用指標"@zh-TW ;
    rdfs:domain fh:Department ;
    rdfs:range fh:Metric ;
    skos:definition "部門採用某項指標衡量業務狀況；不因此決定承作子公司、來源資料權責、理專歸屬或自動加總方式。"@zh-TW ;
    fh:governanceLevel "金控" .

<https://example.org/ontology/holding/organization> a owl:Ontology ;
    rdfs:label "金控｜組織"@zh-TW ;
    rdfs:comment "部門，以及部門採用指標的關係。"@zh-TW ;
    owl:imports <https://example.org/ontology/holding/annotations>,
        <https://example.org/ontology/holding/metrics> ;
    owl:versionIRI <https://example.org/ontology/holding/organization/0.17.0> ;
    owl:versionInfo "0.17.0 / design draft / 2026-10-31" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fh:Department a owl:Class ;
    rdfs:label "部門"@zh-TW ;
    skos:definition "金控或旗下子公司的業務組織單位類型；具體部門與採用指標範圍由子公司及部門描述。"@zh-TW ;
    fh:governanceLevel "金控" .


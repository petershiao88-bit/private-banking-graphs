      "observations": {
        "coverage": "僅納入 INCOME_039 的 SI 分支；尚未納入 INCOME_040 ELI 與 INCOME_041 FCI，不宣稱完整境內手收。",
        "sql_output": "INCOME_039",
        "sql_group_by": [
          "CUSTOMER_ID",
          "TRADE_DATE",
          "S_PCC_CODE"
        ],
        "sql_aggregation": "SUM(FEE_AMOUNT_TWD)",
        "sql_combination": "current／HS 各自聚合後 UNION（非 UNION ALL）",
        "sql_filters": [],
        "event_date": {
          "column": "TRADE_DATE",
          "meaning": "交易日",
          "evidence": [
            "sql_si",
            "metadata_si"
          ]
        },
        "fee_currency": {
          "current_column": "FEE_AMOUNT_TWD",
          "current_unit": "TWD",
          "historical_unit": null,
          "note": "current metadata 說明為手續費換算台幣；歷史表欄位語意未獨立核對，selected currency 保持 null。",
          "evidence": [
            "metadata_si"
          ]
        },
        "gaps": [
          "S_PCC_CODE 在 SQL 中使用，但提供的 current metadata 未列此欄位。",
          "DEALNO 是交易單號，不當作商品 ID。",
          "current metadata 的專員欄位不自動套用到 HS；來源也未證明哪些行員具有理專角色。",
          "既有 SQL 已彙總並移除員編與商品識別，不直接用該彙總還原理專／單一商品手收。"
        ],
        "evidence": [

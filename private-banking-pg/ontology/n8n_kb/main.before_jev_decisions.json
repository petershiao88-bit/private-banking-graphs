    {
      "parameters": {
        "jsCode": "const q = String($('Switch').item.json.output?.resolved_query || $('Router Input').first().json.user_query || '').trim();\nconst rows = $input.all().map(i => i.json);\nconst unique = [...new Map(rows.map(r => [r.metric_code, r])).values()];\nconst labels = unique.map(r => String(r.metric_name || r.metric_code));\nconst calc = /計算|公式|組成|構成|包含|歸類|屬於|分類|項目|怎麼算|如何算/.test(q);\nconst matches = unique.filter(r => { let aliases=[]; try { aliases=JSON.parse(r.aliases||'[]') } catch {} const names=[r.metric_name,...aliases].filter(Boolean).map(String); return names.some(n => q.includes(n)) || q.toLowerCase().includes(String(r.metric_code).toLowerCase()); });\nconst unsupported = /收益率|報酬率|投報率|ROI|成長率|增長率/.test(q) && matches.length===0;\nconst genericAum = /AUM/i.test(q) && !unsupported && /總|整體|全部|哪些|什麼|如何|怎麼|由/.test(q);\nconst capability = /(系統|可以|支援|提供|有哪些指標|哪些指標|範圍)/.test(q) && /(指標|AUM|計算方式|資料)/.test(q) && !/ROI|收益率|報酬率|投報率|成長率|增長率/.test(q);\nconst allowed = capability || !calc || matches.length>0 || genericAum;\nconst scope_reply = '目前只能說明現有 AUM 指標的計算與組成。可詢問：' + labels.join('、') + '。若你指的是其他指標，請先確認是否已納入 metric。';\nreturn [{json:{chatInput:q,scope_route:allowed?'answer':'reject',scope_reply}}];"
      },

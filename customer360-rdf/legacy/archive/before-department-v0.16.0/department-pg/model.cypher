SET n += {business_scope_kind: "product", definition: "私銀依既有 LUM SQL 管理口徑衡量的銀行放款餘額指標；不以授信額度、利收或擔保品估值代替。", definition_department: "私人銀行", department_owner_json: "null", metric_kind: "lum", name: "銀行放款 LUM", observations_json: "{\"amount_observation\":\"來源保留台幣 LN_BAL、外幣 BAL_AMT 的放款餘額觀察；彙總含會科 1886 應付保證標示，實際納入範圍仍待核對，未核定會計分類或公式。\",\"classification_observation\":\"來源 3.LUM_by_day／4.LUM_BY_HS／5.LUM_MERGE 明列 LUM，承作子公司為銀行，使用／定義部門為私人銀行。\",\"coverage\":\"既有私銀 current 與歷史 LUM 取數及彙總分支，不視為跨子公司完整借款清冊。\",\"date_observation\":\"歷史取 YYYYMM；current 彙總觀察 SYSDATE-1 日期。兩者不自動成為已核定的 lumAsOfDate。\",\"evidence\":[\"lum_current\",\"lum_history\",\"lum_roa\",\"lum_summary\"],\"gaps\":[\"保留原 PRFT_CNTR_CD、非零餘額及歷史 YYYYMM 範圍觀察，不設為執行規則。\",\"台外幣計價、來源匯率處理、UNION／UNION ALL 與重複計入仍待定，不自動加總。\",\"客戶／商品識別、實體欄位、管理範圍及資料權責部門待定。\",\"證券股票設質及人壽保單借款尚缺本輪可確認底表，不順帶建立子公司 LUM 分項。\"]}", product_code: "loan", scope: "metadata_only", specific_product_class_uri_json: "null", subsidiary: "bank", table_sources_json: "{\"coverage\":\"僅對應既有私銀銀行 LUM 的 current／歷史餘額來源表，非其他子公司或完整全行範圍。\",\"status\":\"observed_in_files\",\"tables\":[{\"evidence\":[\"lum_current\"],\"role\":\"primary\",\"table\":\"DSLON.LN_FN_ACCT\"},{\"evidence\":[\"lum_history\"],\"role\":\"primary\",\"table\":\"DSLON.LN_FN_ACCT_HS\"},{\"evidence\":[\"lum_current\"],\"role\":\"primary\",\"table\":\"DSLON.LN_NT_ACCT\"},{\"evidence\":[\"lum_history\"],\"role\":\"primary\",\"table\":\"DSLON.LN_NT_ACCT_HS\"}],\"unresolved_supporting_relations\":[]}", using_department: "私人銀行"};

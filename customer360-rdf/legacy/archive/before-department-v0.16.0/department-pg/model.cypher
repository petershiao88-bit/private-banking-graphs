SET n += {definition: "依私銀 SQL 手收分類，涵蓋保險日報 COMM_AMT 與兩項月檔 PS；PS 的客戶貢獻度性質另行保留，不宣稱均為純手續費。", department_owner_json: "null", metric_kind: "fee_income", name: "銀行保險手收", observations_json: "{\"classification_observation\":\"沿用銀行通路 InsuranceProduct；SQL 將日報與月檔歸同一保險手收指標。私銀為使用／定義部門，來源權責仍待定。\",\"coverage\":\"SQL INCOME_028 日報及 INCOME_029／030 月檔均歸手收／銀行／保險；來源涵蓋不代表已查驗完整生產時間範圍。\",\"date_observation\":\"日報用 APPLY_DT；兩項月檔將 LST_MTN_DT 以 ADD_MONTHS(...,1) 移至次月，保留為來源觀察，不直接當收入期間起迄。\",\"evidence\":[\"insurance_contribution_iu_metadata\",\"insurance_contribution_ofi_metadata\",\"insurance_contribution_sql\",\"insurance_fee_metadata\",\"insurance_fee_sql\",\"insurance_income_summary\",\"private_products\"],\"gaps\":[\"只對應指標到底表；客戶、商品識別、幣別、收入期間及欄位映射維持待定。\",\"SQL 計算由 Tool 承接；來源觀察不是可執行規則，未查驗資料庫。\",\"IU 月檔篩選 PS IS NOT NULL；OFI 月檔篩選 OPEN_ACCOUNT='Y'，不互相套用條件。\",\"日報註記僅有特定月份 current；日報與月檔是否重疊未查驗。SQL UNION 只對投影整列去重，不等同保單或交易去重。\",\"日報與月檔沿用同一指標 ID；不建立三個可直接相加的收入指標。\"],\"valuation_observation\":\"日報加總 COMM_AMT；月檔加總 PS，metadata 定義為客戶貢獻度。SQL 分類為手收，不抹除來源性質差異。\"}", product_class_uris_json: "[\"https://example.org/ontology/bank#InsuranceProduct\"]", product_code: "bank_insurance", scope: "metadata_only", specific_product_class_uri_json: "null", subsidiary: "bank", table_sources_json: "{\"coverage\":\"SQL INCOME_028 日報及 INCOME_029／030 月檔均歸手收／銀行／保險；來源涵蓋不代表已查驗完整生產時間範圍。\",\"status\":\"observed_in_files\",\"tables\":[{\"evidence\":[\"insurance_fee_metadata\",\"insurance_fee_sql\"],\"role\":\"primary\",\"table\":\"DSINS.INSU_RPT_Q01\"},{\"evidence\":[\"insurance_contribution_iu_metadata\",\"insurance_contribution_sql\"],\"role\":\"primary\",\"table\":\"DSKPI.KPI_DET_IU_002_NEW\"},{\"evidence\":[\"insurance_contribution_ofi_metadata\",\"insurance_contribution_sql\"],\"role\":\"primary\",\"table\":\"DSKPI.KPI_DET_OFI_001\"}],\"unresolved_supporting_relations\":[]}"};

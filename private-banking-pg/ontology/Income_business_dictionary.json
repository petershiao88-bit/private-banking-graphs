  "metrics": [
    {
      "code": "income_total_customer_month",
      "name": "每客戶每月總收入",
      "definition": "10._INCOME_ROA.sql 的收入子查詢按 CUST_ID 與 SUBSTR(YYYYMMDD,1,6) 加總 INCOME_TMP02.AMT；涵蓋 SQL 歸類的手收及利收。",
      "grain": "CUST_ID × YYYYMM",
      "implementation": "INCOME_TMP02",
      "formula": "SUM(AMT) GROUP BY CUST_ID, SUBSTR(YYYYMMDD,1,6)",
      "status": "observed_in_sql"
    },
    {
      "code": "fee_income",
      "name": "手收（SQL分類）",
      "definition": "TYP='手收' 的收入；其中包含手續費、貢獻度及部分損益欄位。",
      "filter": "TYP='手收'",
      "status": "inferred"
    },
    {
      "code": "bank_fee_income",
      "name": "銀行手收",
      "definition": "TYP='手收' 且 PROD_TYPE='銀行' 的 AMT。",
      "filter": "TYP='手收' AND PROD_TYPE='銀行'",
      "status": "inferred"
    },
    {
      "code": "securities_fee_income",
      "name": "證券手收",
      "definition": "TYP='手收' 且 PROD_TYPE='證券' 的 AMT。",
      "filter": "TYP='手收' AND PROD_TYPE='證券'",
      "status": "inferred"
    },
    {
      "code": "interest_income",
      "name": "利息收入",
      "definition": "TYP='利收' 的存款與放款 AMT。",
      "filter": "TYP='利收'",
      "status": "inferred"
    },
    {
      "code": "deposit_interest_income",
      "name": "存款利收",
      "definition": "INCOME_066 以 GROSS_INCM 彙總存款利收；現況來源僅使用外幣存款表。",
      "filter": "TYP='利收' AND SUB_TYPE='存款'",
      "status": "observed_in_sql"
    },
    {
      "code": "loan_interest_income",
      "name": "放款利收",
      "definition": "INCOME_067 以台幣 GROSS_INCM 及外幣 INT_INCM-CB_INT_AMT 彙總；現況來源僅使用外幣放款表。",
      "filter": "TYP='利收' AND SUB_TYPE='放款'",
      "status": "observed_in_sql"
    },
    {
      "code": "report_income_amount",
      "name": "組織收入報表金額",
      "definition": "INCOME_REPORT 排除 PRFT_CNTR_CD 為 NULL 的列，再按日期、收入類型、機構、產品與組織加總 AMT。",
      "implementation": "INCOME_REPORT",
      "formula": "SUM(AMT)",
      "grain": "YYYYMMDD × TYP × PROD_TYPE × SUB_TYPE × 組織",
      "status": "observed_in_sql"
    },
    {
      "code": "report_row_count",
      "name": "組織收入報表列數",
      "definition": "INCOME_REPORT 的 COUNT(*) 是各組的來源列數，不能直接當成不重複客戶數或交易數。",
      "implementation": "INCOME_REPORT",
      "formula": "COUNT(*)",
      "status": "observed_in_sql"
    }
  ],

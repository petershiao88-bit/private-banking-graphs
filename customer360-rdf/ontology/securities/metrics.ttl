# 證券｜指標 v0.17.0，2026-10-31，設計草案。
# 子公司層－證券／指標：證券 AUM 與手收。
# 由 v0.16.0 的 securities-common.ttl 拆出（FIBO 式模組化），類別與屬性定義未改。example.org 為示意命名空間。

@prefix fh: <https://example.org/ontology/holding#> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix securities: <https://example.org/ontology/securities#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

securities:SecuritiesAUM a owl:Class ;
    rdfs:label "證券 AUM"@zh-TW ;
    rdfs:subClassOf fh:AUM ;
    skos:definition "衡量指定快照日依證券公司管理與認列口徑計算之客戶資產規模的指標。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "證券" .

securities:SecuritiesFeeIncome a owl:Class ;
    rdfs:label "證券手收指標"@zh-TW ;
    rdfs:subClassOf fh:FeeIncome ;
    skos:definition "衡量證券公司於指定收入期間內依其認列規則形成之手收的指標。"@zh-TW ;
    fh:governanceLevel "子公司" ;
    fh:subsidiary "證券" .

<https://example.org/ontology/securities/metrics> a owl:Ontology ;
    rdfs:label "證券｜指標"@zh-TW ;
    rdfs:comment "證券 AUM 與手收。"@zh-TW ;
    owl:imports <https://example.org/ontology/holding/annotations>,
        <https://example.org/ontology/holding/metrics> ;
    owl:versionIRI <https://example.org/ontology/securities/metrics/0.17.0> ;
    owl:versionInfo "0.17.0 / design draft / 2026-10-31" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .


# 金控｜金融商品 v0.17.0，2026-10-31，設計草案。
# 金控層／金融商品：金融商品，以及客戶持有金融商品的關係。
# 由 v0.16.0 的 holding-core.ttl 拆出（FIBO 式模組化），類別與屬性定義未改。example.org 為示意命名空間。

@prefix fh: <https://example.org/ontology/holding#> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

fh:holds a owl:ObjectProperty ;
    rdfs:label "持有金融商品"@zh-TW ;
    rdfs:domain fh:Customer ;
    rdfs:range fh:FinancialProduct ;
    skos:definition "客戶持有金融商品。"@zh-TW ;
    fh:governanceLevel "金控" .

<https://example.org/ontology/holding/products> a owl:Ontology ;
    rdfs:label "金控｜金融商品"@zh-TW ;
    rdfs:comment "金融商品，以及客戶持有金融商品的關係。"@zh-TW ;
    owl:imports <https://example.org/ontology/holding/annotations>,
        <https://example.org/ontology/holding/parties> ;
    owl:versionIRI <https://example.org/ontology/holding/products/0.17.0> ;
    owl:versionInfo "0.17.0 / design draft / 2026-10-31" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fh:FinancialProduct a owl:Class ;
    rdfs:label "金融商品"@zh-TW ;
    skos:definition "金融機構提供的金融商品。"@zh-TW ;
    fh:governanceLevel "金控" .

